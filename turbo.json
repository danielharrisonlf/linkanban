{
	"$schema": "https://turbo.build/schema.json",
	"envMode": "loose",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"start:dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"format": {
			"dependsOn": ["^build"]
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"lint:fix": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"format:fix": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"check:fix": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:watch": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"test:cov": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"docker:build": {
			"dependsOn": [],
			"cache": false
		}
	}
}
