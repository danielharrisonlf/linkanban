# String de conexão com o PostgreSQL
ConnectionStrings__Fio=Host=localhost;Port=5433;Database=linkanban;Username=linkanban;Password=linkanban

# Desenvolvimento local (desativa auth JWT e usa usuário fixo local)
AUTH_DISABLED=true

# Token para bootstrap inicial de usuário (quando auth habilitada)
LINKANBAN_BOOTSTRAP_TOKEN=local-development-token
